// -*- mode: jsonc -*-
[
  {
    "height": 32,
    "spacing": 4,
    "output": ["DP-2"],
    "include": ["~/.config/waybar/config-modules.jsonc"],
    "modules-left": [
      "hyprland/workspaces",
      // "wlr/taskbar",
      "hyprland/window",
    ],
    "modules-center": ["clock", "idle_inhibitor", "custom/cava"],
    "modules-right": [
      "privacy",
      // ↓ each of these is one line — comment it out to disable that module
      "custom/printer", // 3D printer progress (also set ENABLED=0 in ~/.scripts/waybar-moonraker.sh)
      "network", // Wi-Fi dropdown
      "bluetooth", // Bluetooth dropdown
      "pulseaudio",
      "cpu",
      "memory",
      "disk",
      "temperature",
      "custom/power",
    ],
  },
  {
    "height": 32,
    "spacing": 4,
    "output": ["HDMI-A-2"],
    "include": ["~/.config/waybar/config-modules.jsonc"],
    "modules-left": ["hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray"],
  },
]
